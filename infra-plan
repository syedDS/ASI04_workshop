Startup validation added to ctf-dashboard/app.py:


import jsonschema, json, sys

def load_registry():
    with open("/app/challenges/registry.json") as f:
        registry = json.load(f)
    with open("/app/challenges/registry.schema.json") as f:
        schema = json.load(f)
    try:
        jsonschema.validate(registry, schema)
    except jsonschema.ValidationError as e:
        print(f"FATAL: registry.json invalid — {e.message}", file=sys.stderr)
        sys.exit(1)
    return registry
