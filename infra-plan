Lock files are committed to git. Docker builds use --frozen and never update them.

Step 4 — Dockerfiles
Pattern A — Multi-stage with gunicorn (3 feature services):


# ── Stage 1: dependency builder ───────────────────────────────────────────────
FROM ghcr.io/astral-sh/uv:python3.11-bookworm-slim AS builder
WORKDIR /app

ENV UV_COMPILE_BYTECODE=1 \
    UV_LINK_MODE=copy \
    UV_CACHE_DIR=/root/.cache/uv        # ← named cache volume mounts here

# Cached layer — only reruns when pyproject.toml/uv.lock changes
COPY pyproject.toml uv.lock ./
RUN --mount=type=cache,target=/root/.cache/uv \
    uv sync --frozen --no-dev --no-install-project

# Source layer — reruns on code changes only
COPY . .
RUN --mount=type=cache,target=/root/.cache/uv \
    uv sync --frozen --no-dev

# ── Stage 2: slim runtime (no uv, no build cache) ──────────────────────────
FROM python:3.11-slim
WORKDIR /app
COPY --from=builder /app/.venv /app/.venv
COPY --from=builder /app /app

ENV PATH="/app/.venv/bin:$PATH"

# gunicorn: graceful SIGTERM handling, worker management
CMD ["gunicorn", "--bind", "0.0.0.0:3000", "--workers", "2",
     "--timeout", "60", "--graceful-timeout", "10", "app:app"]
(Port changes per service: 3000/ctf-dashboard, 5050/vulnerable-agent, 5080/email-agent)

Pattern B — Single-stage (9 simpler services):


FROM python:3.11-slim
COPY --from=ghcr.io/astral-sh/uv:latest /uv /bin/uv
WORKDIR /app

ENV UV_COMPILE_BYTECODE=1 \
    UV_LINK_MODE=copy

# Cached layer
COPY pyproject.toml uv.lock ./
RUN --mount=type=cache,target=/root/.cache/uv \
    uv sync --frozen --no-dev --no-install-project

COPY . .

# No healthcheck needs curl — Python stdlib handles it (see compose)
CMD ["uv", "run", "python", "app.py"]
--mount=type=cache is the key uv cache addition: BuildKit mounts the uv package cache across builds without it ending up in the image layer. No named volume needed in compose for this — it's a BuildKit build cache.

