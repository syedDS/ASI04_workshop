Step 8 — setup.sh updates

# 1. Check uv
if ! command -v uv &> /dev/null; then
    echo "Installing uv..."
    curl -LsSf https://astral.sh/uv/install.sh | sh
fi

# 2. Generate lock files (safe to re-run; skips if lockfile current)
echo "[*] Generating uv lock files..."
for dir in ctf-dashboard vulnerable-agent attacker-server \
           legitimate-packages poisoned-registry rag-poisoning malicious-mcp \
           mcp-ecosystem-lab/{email-agent,detection-engine,mcp-postmark-sim,bcc-interceptor,dependency-injector}; do
    (cd "$dir" && uv lock --quiet) && echo "  ✓ $dir"
done

# 3. Validate registry before building
echo "[*] Validating challenge registry..."
python3 -c "
import json, jsonschema
registry = json.load(open('challenges/registry.json'))
schema = json.load(open('challenges/registry.schema.json'))
jsonschema.validate(registry, schema)
print('  ✓ registry.json valid')
"

# 4. Build (BuildKit required for --mount=type=cache)
DOCKER_BUILDKIT=1 docker compose build

# 5. Start and wait for healthy
docker compose --profile full up -d --wait
